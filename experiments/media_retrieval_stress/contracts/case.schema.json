{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-news-daily.local/media-retrieval-stress/case.schema.json",
  "title": "Multimedia Retrieval Stress Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "severity",
    "narration",
    "target",
    "retrieval",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "category": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "severity": {
      "enum": [
        "medium",
        "high",
        "critical"
      ]
    },
    "narration": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2000
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_mention",
        "entity_type",
        "ambiguity_policy",
        "domain_context",
        "expected_canonical_terms",
        "forbidden_identity_terms"
      ],
      "properties": {
        "surface_mention": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "entity_type": {
          "enum": [
            "person",
            "event",
            "place",
            "organization",
            "product",
            "franchise_object",
            "artifact",
            "concept",
            "other"
          ]
        },
        "ambiguity_policy": {
          "enum": [
            "exact",
            "contextual",
            "refuse_if_ambiguous"
          ]
        },
        "domain_context": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "expected_canonical_terms": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "forbidden_identity_terms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactness",
        "media_types",
        "query_term_groups",
        "forbidden_terms"
      ],
      "properties": {
        "exactness": {
          "enum": [
            "exact",
            "contextual",
            "analogy"
          ]
        },
        "media_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "image",
              "video"
            ]
          }
        },
        "period": {
          "type": "string",
          "maxLength": 100
        },
        "geography": {
          "type": "string",
          "maxLength": 160
        },
        "query_term_groups": {
          "type": "array",
          "maxItems": 8,
          "description": "AND between groups, OR within each group. At least one generated query should satisfy all groups.",
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "forbidden_terms": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_action",
        "min_queries",
        "max_queries"
      ],
      "properties": {
        "planner_action": {
          "enum": [
            "search",
            "refuse"
          ]
        },
        "min_queries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_queries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expected": {
            "properties": {
              "planner_action": {
                "const": "refuse"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "properties": {
              "min_queries": {
                "const": 0
              },
              "max_queries": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
