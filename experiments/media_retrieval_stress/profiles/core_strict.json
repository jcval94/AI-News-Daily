      "media_types",
      "exactness",
      "forbidden_terms",
      "period",
      "geography"
    ],
    "hard_fail_critic_codes": [
      "wrong_entity",
      "missing_qualifier",
      "query_drift",
      "forbidden_term",
      "ambiguity_guess",
      "unsupported_alias",
      "literalized_metaphor",
      "negation_violation",
