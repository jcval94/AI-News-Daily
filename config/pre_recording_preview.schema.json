{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/pre-recording-preview-v1.json",
  "title": "AI News Daily Pre-recording Preview Plan",
  "type": "object",
  "required": ["schema_version","episode_date","status","source","format","policy","summary","segments"],
  "properties": {
    "schema_version": {"const": 1},
    "episode_date": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "status": {"const":"pre_recording_preview_plan"},
    "source": {
      "type":"object",
      "required":["resolve_bridge_plan","timing_authority"],
      "properties":{
        "resolve_bridge_plan":{"type":"string","minLength":1},
        "timing_authority":{"const":"estimated_pre_recording_timeline"}
      },
      "additionalProperties":false
    },
    "format":{
      "type":"object",
      "required":["width","height","frame_rate_fps","video_codec","pixel_format","audio"],
      "properties":{
        "width":{"type":"integer","minimum":320},
        "height":{"type":"integer","minimum":180},
        "frame_rate_fps":{"type":"integer","minimum":1},
        "video_codec":{"const":"libx264"},
        "pixel_format":{"const":"yuv420p"},
        "audio":{"const":"silent_aac_stereo"}
      },
      "additionalProperties":false
    },
    "policy":{
      "type":"object",
      "required":["layer_priority","resolved_broll_over_presenter","missing_broll_slate_over_presenter","watermark_required","publishable","frame_accurate","requires_recording_retime"],
      "properties":{
        "layer_priority":{"const":["V2","V1"]},
        "resolved_broll_over_presenter":{"const":true},
        "missing_broll_slate_over_presenter":{"const":true},
        "watermark_required":{"const":true},
        "publishable":{"const":false},
        "frame_accurate":{"const":false},
        "requires_recording_retime":{"const":true}
      },
      "additionalProperties":false
    },
    "summary":{
      "type":"object",
      "required":["duration_seconds","segment_count","presenter_seconds","broll_seconds","resolved_broll_seconds","placeholder_broll_seconds","broll_coverage_ratio"],
      "properties":{
        "duration_seconds":{"type":"number","exclusiveMinimum":0},
        "segment_count":{"type":"integer","minimum":1},
        "presenter_seconds":{"type":"number","minimum":0},
        "broll_seconds":{"type":"number","minimum":0},
        "resolved_broll_seconds":{"type":"number","minimum":0},
        "placeholder_broll_seconds":{"type":"number","minimum":0},
        "broll_coverage_ratio":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "segments":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["segment_id","placement_id","track_id","timeline_start_seconds","timeline_end_seconds","duration_seconds","source_offset_seconds","logical_repo_path","source_kind","placeholder"],
        "properties":{
          "segment_id":{"type":"string","minLength":1},
          "placement_id":{"type":"string","minLength":1},
          "track_id":{"enum":["V1","V2"]},
          "timeline_start_seconds":{"type":"number","minimum":0},
          "timeline_end_seconds":{"type":"number","exclusiveMinimum":0},
          "duration_seconds":{"type":"number","exclusiveMinimum":0},
          "source_offset_seconds":{"type":"number","minimum":0},
          "logical_repo_path":{"type":"string","minLength":1},
          "source_kind":{"enum":["image","video"]},
          "placeholder":{"type":"boolean"}
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":false
}
