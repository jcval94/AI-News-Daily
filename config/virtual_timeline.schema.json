{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/virtual-timeline-v1.json",
  "title": "AI News Daily Virtual Timeline",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "status",
    "timing",
    "sources",
    "editing_style",
    "format",
    "markers",
    "replacement_contract",
    "readiness",
    "summary",
    "track_summaries",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "pre_recording_virtual_timeline"
    },
    "timing": {
      "type": "object",
      "required": [
        "basis",
        "duration_seconds",
        "approved_script_duration_seconds",
        "post_script_duration_seconds",
        "frame_rate_fps",
        "frame_accurate",
        "requires_recording_retime"
      ],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "approved_script_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "post_script_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "frame_rate_fps": {
          "type": "integer",
          "minimum": 1
        },
        "frame_accurate": {
          "const": false
        },
        "requires_recording_retime": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object"
    },
    "editing_style": {
      "type": "object"
    },
    "replacement_contract": {
      "type": "object",
      "required": [
        "virtual_a_roll_authority",
        "strategy",
        "real_a_roll_may_change_duration",
        "retime_b_roll_after_alignment",
        "never_treat_estimated_seconds_as_source_timecode"
      ],
      "properties": {
        "virtual_a_roll_authority": {
          "const": "take_id"
        },
        "strategy": {
          "const": "replace_and_retime_after_alignment"
        },
        "real_a_roll_may_change_duration": {
          "const": true
        },
        "retime_b_roll_after_alignment": {
          "const": true
        },
        "never_treat_estimated_seconds_as_source_timecode": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "virtual_timeline_contract_valid",
        "ready_for_virtual_preview",
        "ready_for_real_a_roll_replace",
        "ready_for_automated_nle_import",
        "blockers_for_final"
      ],
      "properties": {
        "virtual_timeline_contract_valid": {
          "const": true
        },
        "ready_for_virtual_preview": {
          "const": true
        },
        "ready_for_real_a_roll_replace": {
          "const": false
        },
        "ready_for_automated_nle_import": {
          "const": false
        },
        "blockers_for_final": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object"
    },
    "track_summaries": {
      "type": "object"
    },
    "tracks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "track_id",
          "kind",
          "name",
          "clips"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "clip_id",
                "kind",
                "status",
                "name",
                "timeline_start_seconds",
                "timeline_end_seconds",
                "duration_seconds",
                "source"
              ],
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "media_provenance": {
                      "$ref": "#/$defs/media_provenance"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "resolution",
        "frame_rate_fps",
        "audio_sample_rate_hz",
        "aspect_ratio"
      ],
      "properties": {
        "resolution": {
          "type": "string"
        },
        "frame_rate_fps": {
          "type": "integer",
          "minimum": 1
        },
        "audio_sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "marker_id",
          "kind",
          "timeline_seconds",
          "label"
        ],
        "properties": {
          "marker_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "take",
              "section"
            ]
          },
          "timeline_seconds": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "take_id": {
            "type": "string"
          },
          "section_key": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "media_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_asset_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rendition_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "need_id": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "exact",
            "context"
          ]
        },
        "quality": {
          "enum": [
            "standard",
            "lowres"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "original_offset_seconds": {
          "type": "number",
          "minimum": 0
        },
        "catalogue_evidence": {
          "type": "object",
          "required": [
            "field",
            "quote",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "limitation": {
          "type": "string"
        },
        "sidecar_paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "source_asset_id",
        "rendition_id",
        "need_id",
        "relation",
        "quality",
        "width",
        "height",
        "original_offset_seconds",
        "catalogue_evidence",
        "limitation",
        "sidecar_paths"
      ]
    }
  }
}
