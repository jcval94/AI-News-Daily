{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/recording-alignment-v1.json",
  "title": "AI News Daily Recording Alignment",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "status",
    "sources",
    "policy",
    "summary",
    "readiness",
    "takes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "aligned",
        "needs_human_review",
        "alignment_incomplete"
      ]
    },
    "sources": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "take_count",
        "auto_selected_take_count",
        "review_take_count",
        "missing_transcript_take_count",
        "aligned_spoken_seconds"
      ]
    },
    "readiness": {
      "type": "object",
      "required": [
        "ready_for_aligned_timeline",
        "blockers",
        "warnings"
      ]
    },
    "takes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "take_id",
          "recommended_retake",
          "final_selected_retake",
          "needs_human_review",
          "candidates"
        ],
        "properties": {
          "take_id": {
            "type": "string",
            "minLength": 1
          },
          "recommended_retake": {
            "type": [
              "integer",
              "null"
            ]
          },
          "final_selected_retake": {
            "type": [
              "integer",
              "null"
            ]
          },
          "needs_human_review": {
            "type": "boolean"
          },
          "candidates": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
