{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_run_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target_date",
    "status",
    "privacy",
    "preflight",
    "steps",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "target_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "running",
        "success",
        "blocked",
        "failed"
      ]
    },
    "privacy": {
      "type": "object",
      "required": [
        "absolute_paths_persisted",
        "raw_media_uploaded"
      ],
      "properties": {
        "absolute_paths_persisted": {
          "const": false
        },
        "raw_media_uploaded": {
          "const": false
        }
      }
    },
    "preflight": {
      "type": "object",
      "required": [
        "status",
        "blockers",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_run"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "success",
              "skipped",
              "failed"
            ]
          },
          "receipt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "blockers",
        "warnings"
      ],
      "properties": {
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
