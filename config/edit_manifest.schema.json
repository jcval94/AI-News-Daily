{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/edit-manifest-v1.json",
  "title": "AI News Daily Edit Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "status",
    "timing",
    "sources",
    "editing_defaults",
    "editing_style",
    "style_warnings",
    "readiness",
    "summary",
    "timeline"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "pre_recording"
    },
    "timing": {
      "type": "object",
      "required": [
        "basis",
        "words_per_second",
        "duration_seconds",
        "requires_recording_retime"
      ],
      "properties": {
        "basis": {
          "const": "estimated_script_words"
        },
        "words_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "requires_recording_retime": {
          "const": true
        },
        "warning": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object"
    },
    "editing_defaults": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "segment_count",
        "media_segment_count",
        "presenter_segment_count",
        "media_cue_count",
        "manifest_asset_record_count",
        "resolved_media_cue_count",
        "blocked_media_cue_count"
      ],
      "properties": {
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "media_segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "presenter_segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "media_cue_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_asset_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_media_cue_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_media_cue_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "validation_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "mode",
          "start_seconds",
          "end_seconds",
          "duration_seconds",
          "section",
          "script_anchor",
          "director",
          "media"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "presenter",
              "media"
            ]
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "cue_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "section": {
            "type": "object"
          },
          "script_anchor": {
            "type": "object"
          },
          "director": {
            "type": "object",
            "required": [
              "authority",
              "intent",
              "visual_role",
              "transition_in",
              "transition_out",
              "treatment",
              "pacing",
              "return_to_presenter",
              "note"
            ],
            "properties": {
              "authority": {
                "const": "suggestion"
              },
              "priority": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "visual_role": {
                "type": "string"
              },
              "transition_in": {
                "type": "string"
              },
              "transition_out": {
                "type": "string"
              },
              "treatment": {
                "type": "string"
              },
              "pacing": {
                "type": "string"
              },
              "return_to_presenter": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "media": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "available",
                  "usable_for_edit",
                  "file_exists",
                  "blockers",
                  "file",
                  "asset_type",
                  "preferred_asset_type",
                  "visual_query",
                  "on_screen_text"
                ],
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "usable_for_edit": {
                    "type": "boolean"
                  },
                  "file_exists": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "blockers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "file": {
                    "type": "string"
                  },
                  "asset_type": {
                    "type": "string"
                  },
                  "preferred_asset_type": {
                    "type": "string"
                  },
                  "mime_type": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string"
                  },
                  "creator": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string"
                  },
                  "license_valid": {
                    "type": "boolean"
                  },
                  "requires_attribution": {
                    "type": "boolean"
                  },
                  "visual_query": {
                    "type": "string"
                  },
                  "on_screen_text": {
                    "type": "string"
                  },
                  "relevance_score": {},
                  "errors": {
                    "type": "array"
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "pre_recording_contract_valid",
        "ready_for_recording",
        "asset_resolution_complete",
        "ready_for_automated_timeline_import",
        "blockers"
      ],
      "properties": {
        "pre_recording_contract_valid": {
          "const": true
        },
        "ready_for_recording": {
          "const": true
        },
        "asset_resolution_complete": {
          "type": "boolean"
        },
        "ready_for_automated_timeline_import": {
          "const": false
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "editing_style": {
      "type": "object",
      "required": [
        "applied"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "style_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "style_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
