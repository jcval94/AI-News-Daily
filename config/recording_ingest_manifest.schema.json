{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/recording-ingest-manifest-v1.json",
  "title": "AI News Daily Recording Ingest Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "status",
    "source",
    "selection_policy",
    "readiness",
    "summary",
    "unmatched_files",
    "files",
    "takes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "ready_for_alignment",
        "ingest_incomplete"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "recording_ingest_contract",
        "input_root_name",
        "absolute_input_path_persisted"
      ],
      "properties": {
        "absolute_input_path_persisted": {
          "const": false
        }
      }
    },
    "selection_policy": {
      "type": "object"
    },
    "readiness": {
      "type": "object",
      "required": [
        "ready_for_alignment",
        "blockers",
        "warnings"
      ],
      "properties": {
        "ready_for_alignment": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "expected_take_count",
        "take_count_with_candidate",
        "missing_or_unusable_take_count",
        "discovered_media_file_count",
        "unmatched_media_file_count",
        "take_count_with_multiple_retakes"
      ]
    },
    "unmatched_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "matched",
          "take_id",
          "retake_number",
          "label",
          "media_type",
          "extension",
          "relative_path",
          "bytes",
          "sha256",
          "inspection"
        ],
        "properties": {
          "matched": {
            "const": true
          },
          "take_id": {
            "type": "string",
            "minLength": 1
          },
          "retake_number": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "enum": [
              "video",
              "audio"
            ]
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "inspection": {
            "type": "object"
          }
        }
      }
    },
    "takes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "take_id",
          "expected_capture_seconds",
          "retake_count",
          "technical_preferred_retake",
          "technical_preferred",
          "candidates"
        ],
        "properties": {
          "take_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_capture_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "retake_count": {
            "type": "integer",
            "minimum": 0
          },
          "technical_preferred_retake": {
            "type": [
              "integer",
              "null"
            ]
          },
          "technical_preferred": {
            "type": [
              "object",
              "null"
            ]
          },
          "candidates": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
