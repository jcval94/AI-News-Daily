{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-news-daily.local/media-retrieval-stress/killer-result.schema.json",
  "title": "Killer Multimedia Retrieval Experiment Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_date",
    "method",
    "summary",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "run_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "entity_resolution_pass",
        "exact_discovery_pass",
        "visual_verification_pass",
        "exact_usable",
        "exact_reference_only",
        "wrong_substitutions",
        "scene_offsets_resolved"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "entity_resolution_pass": {
          "type": "integer",
          "minimum": 0
        },
        "exact_discovery_pass": {
          "type": "integer",
          "minimum": 0
        },
        "visual_verification_pass": {
          "type": "integer",
          "minimum": 0
        },
        "exact_usable": {
          "type": "integer",
          "minimum": 0
        },
        "exact_reference_only": {
          "type": "integer",
          "minimum": 0
        },
        "wrong_substitutions": {
          "type": "integer",
          "minimum": 0
        },
        "scene_offsets_resolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "entity_resolution",
          "exact_discovery",
          "visual_verification",
          "usability",
          "final_status",
          "evidence",
          "diagnosis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "entity_resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "canonical_identity",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "ambiguous"
                ]
              },
              "canonical_identity": {
                "type": "string",
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1200
              }
            }
          },
          "exact_discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "best_reference",
              "source_type",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "found_exact",
                  "found_contextual",
                  "not_found"
                ]
              },
              "best_reference": {
                "type": "string",
                "maxLength": 2000
              },
              "source_type": {
                "enum": [
                  "official",
                  "government",
                  "commons",
                  "institutional",
                  "video_platform",
                  "other"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1200
              }
            }
          },
          "visual_verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "method",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "partial",
                  "not_verified"
                ]
              },
              "method": {
                "enum": [
                  "image",
                  "page_and_image",
                  "metadata_and_frames",
                  "transcript_and_scene",
                  "documentary_context"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1200
              },
              "scene_intervals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "label"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "minLength": 4,
                      "maxLength": 20
                    },
                    "end": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "label": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          },
          "usability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "rights_basis",
              "conditions"
            ],
            "properties": {
              "status": {
                "enum": [
                  "usable",
                  "reference_only",
                  "blocked",
                  "review_required"
                ]
              },
              "rights_basis": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1200
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          },
          "final_status": {
            "enum": [
              "FOUND_EXACT_USABLE",
              "FOUND_EXACT_REFERENCE_ONLY",
              "FOUND_CONTEXTUAL",
              "NOT_FOUND",
              "AMBIGUOUS"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url",
                "supports"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2000
                },
                "supports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "identity",
                      "discovery",
                      "visual",
                      "rights",
                      "scene_offset"
                    ]
                  }
                }
              }
            }
          },
          "diagnosis": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
