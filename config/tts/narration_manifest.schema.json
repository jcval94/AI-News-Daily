{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narration_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "sections": {
            "items": {
              "required": ["pause_after_seconds", "timeline_end_seconds"]
            }
          },
          "metrics": {
            "required": ["spoken_duration_seconds", "pause_duration_seconds"]
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "manifest_id",
    "run_id",
    "script_id",
    "episode_date",
    "generated_at_utc",
    "status",
    "engine",
    "render",
    "source",
    "files",
    "sections",
    "metrics",
    "qa",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "script_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at_utc": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "used",
        "voice",
        "language",
        "local_first",
        "network_required"
      ],
      "properties": {
        "requested": {
          "enum": [
            "kokoro",
            "piper",
            "edge"
          ]
        },
        "used": {
          "enum": [
            "kokoro",
            "piper",
            "edge"
          ]
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "es"
        },
        "local_first": {
          "type": "boolean"
        },
        "network_required": {
          "type": "boolean"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_sample_rate_hz",
        "channels",
        "sample_format",
        "speed"
      ],
      "properties": {
        "edit_sample_rate_hz": {
          "const": 48000
        },
        "channels": {
          "const": 1
        },
        "sample_format": {
          "const": "pcm_s16le"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_path",
        "sections_path",
        "sections_schema_version"
      ],
      "properties": {
        "script_path": {
          "type": "string"
        },
        "sections_path": {
          "type": "string"
        },
        "sections_schema_version": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_edit",
        "web_preview"
      ],
      "properties": {
        "master_edit": {
          "type": "string"
        },
        "web_preview": {
          "type": "string"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "order",
          "section_key",
          "source_text",
          "spoken_text",
          "audio_native_file",
          "audio_edit_file",
          "start_seconds",
          "end_seconds",
          "duration_seconds",
          "qa"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "section_key": {
            "type": "string"
          },
          "source_text": {
            "type": "string"
          },
          "spoken_text": {
            "type": "string",
            "minLength": 1
          },
          "audio_native_file": {
            "type": "string"
          },
          "audio_edit_file": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pause_after_seconds": {
            "type": "number",
            "minimum": 0
          },
          "timeline_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "qa": {
            "type": "object"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "section_count",
        "duration_seconds",
        "generation_seconds",
        "real_time_factor",
        "web_preview_size_bytes"
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "warnings",
        "master"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
