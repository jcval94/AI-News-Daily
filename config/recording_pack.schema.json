{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/recording-pack-v1.json",
  "title": "AI News Daily Recording Pack",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "status",
    "sources",
    "take_policy",
    "capture_recommendation",
    "recording_protocol",
    "teleprompter_defaults",
    "readiness",
    "summary",
    "takes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "episode_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "status": {"const": "pre_recording"},
    "sources": {
      "type": "object",
      "required": ["script", "script_sections", "production_script", "edit_manifest", "script_sha256"],
      "additionalProperties": true
    },
    "take_policy": {
      "type": "object",
      "required": [
        "min_seconds",
        "target_seconds",
        "max_seconds",
        "words_per_second",
        "split_basis",
        "approved_script_is_immutable"
      ],
      "properties": {
        "min_seconds": {"type": "number", "exclusiveMinimum": 0},
        "target_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "words_per_second": {"type": "number", "exclusiveMinimum": 0},
        "approved_script_is_immutable": {"const": true}
      },
      "additionalProperties": true
    },
    "capture_recommendation": {"type": "object"},
    "recording_protocol": {"type": "object"},
    "teleprompter_defaults": {"type": "object"},
    "readiness": {
      "type": "object",
      "required": [
        "recording_contract_valid",
        "ready_to_record",
        "requires_recorded_media",
        "ready_for_alignment",
        "blockers_after_recording"
      ],
      "properties": {
        "recording_contract_valid": {"const": true},
        "ready_to_record": {"type": "boolean"},
        "requires_recorded_media": {"const": true},
        "ready_for_alignment": {"const": false},
        "blockers_after_recording": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "take_count",
        "section_count",
        "script_word_count",
        "cta_word_count",
        "recording_word_count",
        "estimated_recording_script_seconds",
        "takes_with_edit_cues"
      ],
      "additionalProperties": true
    },
    "takes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "take_id",
          "take_number_in_section",
          "section_position",
          "section_key",
          "section_kind",
          "section_label",
          "spoken_slate",
          "spoken_text",
          "word_count",
          "estimated_start_seconds",
          "estimated_end_seconds",
          "estimated_duration_seconds",
          "delivery",
          "recording_cues",
          "edit_cues"
        ],
        "properties": {
          "take_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "spoken_text": {"type": "string", "minLength": 1},
          "word_count": {"type": "integer", "minimum": 1},
          "estimated_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "delivery": {"type": "object"},
          "recording_cues": {"type": "object"},
          "edit_cues": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
