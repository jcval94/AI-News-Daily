{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI News Daily curated audio library v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "creator",
          "kind",
          "provider",
          "source_url",
          "license",
          "rights_review",
          "tags",
          "intensity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "creator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "music",
              "sfx",
              "transition",
              "ambience"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 24,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "intensity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "local_relpath": {
            "type": "string",
            "pattern": "^assets/[A-Za-z0-9_./-]+$"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "terms_url",
              "evidence_url",
              "checked_on"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              },
              "terms_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "evidence_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "checked_on": {
                "type": "string",
                "format": "date"
              },
              "attribution_text": {
                "type": "string",
                "maxLength": 2000
              }
            }
          },
          "rights_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "commercial_use_confirmed": {
                "type": "boolean"
              },
              "synchronization_confirmed": {
                "type": "boolean"
              },
              "edits_confirmed": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "maxLength": 2000
              },
              "rights_basis": {
                "enum": [
                  "creative_commons",
                  "provider_specific",
                  "direct_permission"
                ]
              },
              "usage_platforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "youtube",
                    "instagram",
                    "tiktok",
                    "podcast",
                    "other"
                  ]
                }
              },
              "track_specific_evidence_confirmed": {
                "type": "boolean"
              },
              "evidence_description": {
                "type": "string",
                "minLength": 25,
                "maxLength": 800
              },
              "attribution_required": {
                "type": "boolean"
              },
              "content_id_review": {
                "enum": [
                  "unchecked",
                  "no_known_claim",
                  "possible_claim",
                  "active_claim"
                ]
              },
              "content_id_risk_accepted": {
                "type": "boolean"
              },
              "preview_redistribution_allowed": {
                "type": "boolean"
              },
              "share_alike_obligations_acknowledged": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "approved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reviewer",
                    "reviewed_on",
                    "commercial_use_confirmed",
                    "synchronization_confirmed",
                    "edits_confirmed",
                    "rights_basis",
                    "usage_platforms",
                    "track_specific_evidence_confirmed",
                    "evidence_description",
                    "attribution_required",
                    "content_id_review",
                    "preview_redistribution_allowed"
                  ],
                  "properties": {
                    "commercial_use_confirmed": {
                      "const": true
                    },
                    "synchronization_confirmed": {
                      "const": true
                    },
                    "edits_confirmed": {
                      "const": true
                    },
                    "track_specific_evidence_confirmed": {
                      "const": true
                    },
                    "usage_platforms": {
                      "contains": {
                        "const": "youtube"
                      }
                    }
                  }
                }
              }
            ]
          },
          "mood": {
            "enum": [
              "calm",
              "curious",
              "tense",
              "hopeful",
              "playful",
              "dramatic",
              "neutral"
            ]
          }
        }
      }
    }
  }
}
