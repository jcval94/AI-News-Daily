{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/recording-alignment-contract-v1.json",
  "title": "AI News Daily Recording Alignment Contract",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "status",
    "sources",
    "policy",
    "providers",
    "resolve_handoff",
    "expected_takes",
    "readiness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "awaiting_recording_alignment"
    },
    "sources": {
      "type": "object",
      "required": [
        "recording_pack",
        "recording_ingest_contract"
      ]
    },
    "policy": {
      "type": "object"
    },
    "providers": {
      "type": "object",
      "required": [
        "primary_transcription",
        "resolve_native_transcription",
        "whisperx"
      ],
      "properties": {
        "primary_transcription": {
          "const": "whisperx_local"
        },
        "resolve_native_transcription": {
          "type": "object"
        },
        "whisperx": {
          "type": "object"
        }
      }
    },
    "resolve_handoff": {
      "type": "object",
      "required": [
        "primary_postproduction_host",
        "external_audio_sync",
        "create_new_aligned_timeline",
        "never_overwrite_existing_timeline",
        "native_transcription_is_not_alignment_authority"
      ],
      "properties": {
        "primary_postproduction_host": {
          "const": "davinci_resolve"
        },
        "external_audio_sync": {
          "const": "waveform"
        },
        "create_new_aligned_timeline": {
          "const": true
        },
        "never_overwrite_existing_timeline": {
          "const": true
        },
        "native_transcription_is_not_alignment_authority": {
          "const": true
        }
      }
    },
    "expected_takes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "take_id",
          "expected_text",
          "expected_word_count",
          "technical_preference_is_provisional"
        ],
        "properties": {
          "take_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_text": {
            "type": "string",
            "minLength": 1
          },
          "expected_word_count": {
            "type": "integer",
            "minimum": 1
          },
          "technical_preference_is_provisional": {
            "const": true
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "contract_valid",
        "ready_for_transcription",
        "ready_for_alignment",
        "blockers"
      ],
      "properties": {
        "contract_valid": {
          "const": true
        },
        "ready_for_transcription": {
          "const": false
        },
        "ready_for_alignment": {
          "const": false
        },
        "blockers": {
          "type": "array",
          "contains": {
            "const": "recording_ingest_manifest_required"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
