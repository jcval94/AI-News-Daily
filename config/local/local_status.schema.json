{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preflight_status",
    "toolchain_snapshot",
    "acceptance_status",
    "acceptance_tier",
    "repo_request_count",
    "staged_job_count",
    "receipt_count",
    "repo_requests",
    "staged_jobs",
    "latest_receipt",
    "active_job_count",
    "stale_job_count",
    "active_jobs",
    "stale_jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "preflight_status": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "not_run"
      ]
    },
    "toolchain_snapshot": {
      "type": "boolean"
    },
    "acceptance_status": {
      "enum": [
        "pass",
        "warn",
        "partial",
        "fail",
        "not_run"
      ]
    },
    "acceptance_tier": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "P0",
        "P0_RESOLVE",
        "P1",
        null
      ]
    },
    "repo_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "staged_job_count": {
      "type": "integer",
      "minimum": 0
    },
    "receipt_count": {
      "type": "integer",
      "minimum": 0
    },
    "repo_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staged_jobs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latest_receipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_job_count": {
      "type": "integer",
      "minimum": 0
    },
    "stale_job_count": {
      "type": "integer",
      "minimum": 0
    },
    "active_jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/heartbeatStatus"
      }
    },
    "stale_jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/heartbeatStatus"
      }
    }
  },
  "$defs": {
    "heartbeatStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "operation",
        "last_heartbeat_at",
        "age_seconds"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "last_heartbeat_at": {
          "type": "string",
          "minLength": 10
        },
        "age_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
