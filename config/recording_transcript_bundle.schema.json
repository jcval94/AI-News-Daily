{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcval94.github.io/AI-News-Daily/schemas/recording-transcript-bundle-v1.json",
  "title": "AI News Daily Recording Transcript Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "episode_date",
    "provider",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "take_id",
          "retake_number",
          "source_relative_path",
          "language",
          "text",
          "words"
        ],
        "properties": {
          "take_id": {
            "type": "string",
            "minLength": 1
          },
          "retake_number": {
            "type": "integer",
            "minimum": 1
          },
          "source_relative_path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "word",
                "start",
                "end"
              ],
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
