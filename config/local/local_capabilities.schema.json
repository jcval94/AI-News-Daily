{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_version",
    "generated_from_preflight",
    "tools",
    "operations",
    "planned_operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness_version": {
      "const": 1
    },
    "generated_from_preflight": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "tools": {
      "type": "object"
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "planned_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
