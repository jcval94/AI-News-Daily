{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_harness_audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "failed_checks",
    "checks",
    "acceptance_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "passed",
        "failed"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_proves",
        "ci_does_not_prove"
      ],
      "properties": {
        "ci_proves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ci_does_not_prove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
