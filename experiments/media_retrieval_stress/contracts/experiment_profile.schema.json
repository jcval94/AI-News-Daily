{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-news-daily.local/media-retrieval-stress/experiment-profile.schema.json",
  "title": "Multimedia Retrieval Stress Experiment Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "case_ids",
    "repetitions",
    "critic_enabled",
    "reasoning_effort",
    "thresholds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "case_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "critic_enabled": {
      "type": "boolean"
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_overall_pass_rate",
        "min_case_pass_rate",
        "require_identity_stability",
        "max_errors",
        "hard_fail_checks"
      ],
      "properties": {
        "min_overall_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_case_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_identity_stability": {
          "type": "boolean"
        },
        "max_errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hard_fail_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "case_id",
              "surface_mention",
              "decision",
              "query_count",
              "ambiguity_refusal",
              "identity_type",
              "canonical_terms",
              "domain_context",
              "query_term_groups",
              "media_types",
              "exactness",
              "forbidden_terms",
              "period",
              "geography"
            ]
          }
        }
      }
    }
  }
}
